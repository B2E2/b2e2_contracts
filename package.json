{
  "name": "b2e2_contracts",
  "version": "1.0.0",
  "description": "",
  "main": "truffle-config.js",
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "ethereumjs-util": "^7.1.5",
    "ganache": "^7.9.2",
    "truffle": "^5.11.5",
    "truffle-assertions": "^0.9.2",
    "truffle-contract-size": "^2.0.1"
  },
  "scripts": {
    "lint": "npx eslint --max-warnings 0 .",
    "lintfix": "npx eslint --max-warnings 0 --fix .",
    "prebuild": "npm install",
    "build": "npm run clean && npm run update-submodules && npm i && npm run compile-contracts",
    "tests": "npm run start-test-chain && (npm run tests-on-running-chain; STATUS=$?; npm run kill-test-chain; exit $STATUS)",
    "start-test-chain": "set -a && . ./.env && set +a && ./start_ganache_async.sh",
    "kill-test-chain": "kill $(ps aux | grep '[g]anache-cli' | awk '{print $2}')",
    "tests-on-running-chain": "set -a && . ./.env && set +a && npx truffle test --network development",
    "compile-contracts": "npx truffle compile && npm run normalize-abis",
    "normalize-abis": "node scripts/normalize-abis.js",
    "clean": "rm -rf ./build; rm -rf ./node_modules",
    "update-submodules": "git submodule update --recursive --init"
  },
  "author": "B2E2 Community <b2e2@enbw.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0"
  },
  "overrides": {
    "axios@1.0.0 - 1.19.0": "1.21.0",
    "bn.js@^4.11.0": "4.12.5",
    "body-parser@<1.20.9": "1.20.9",
    "brace-expansion@<=1.1.20": "1.1.21",
    "brace-expansion@2.0.0 - 2.1.6": "2.1.7",
    "brace-expansion@4.0.0 - 5.0.11": "5.0.12",
    "decode-uri-component@<=0.5.0": "0.5.1",
    "diff@5.0.0 - 5.2.1": "5.2.2",
    "fast-uri@<=3.1.8": "3.1.9",
    "follow-redirects@<=1.16.1": "1.16.2",
    "form-data@<=2.5.5": "2.5.6",
    "js-yaml@4.0.0 - 4.3.1": "4.3.2",
    "lodash@<=4.17.23": "4.18.1",
    "nanoid@<=3.3.17": "3.3.18",
    "pbkdf2@<=3.1.6": "3.1.7",
    "proxy-addr@<=2.0.7": "2.0.8",
    "qs@<=6.16.0": "6.17.1",
    "secp256k1@4.0.0 - 4.0.3": "4.0.5",
    "semver@>=2.0.0-alpha <5.7.2": "5.7.2",
    "serialize-javascript@<=7.1.2": "7.1.4",
    "tar@<=7.5.20": "7.5.22",
    "tough-cookie@<4.1.3": "4.1.4",
    "ws@8.0.0 - 8.20.1": "8.22.0",
    "ws@1.1.0 - 5.2.4": "5.2.7",
    "yargs-parser@<=5.0.0": "5.0.1",
    "eth-lib": {
      "ws": "5.2.7"
    },
    "@trufflesuite/uws-js-unofficial": {
      "ws": "8.22.0"
    },
    "ganache": {
      "lodash": "4.18.1",
      "secp256k1": "4.0.5"
    },
    "elliptic": {
      "bn.js": "4.12.5"
    },
    "async": {
      "lodash": "4.18.1"
    }
  }
}
